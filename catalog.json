      "repo": "joshpack/PaxMediaManager",
      "kind": "zip",
      "asset": "^PaxMediaManager-.*-win-x64-portable\\.zip$",
      "exe": "PaxMediaManager.exe",
      "folder": "PaxMediaManager",
      "openArgs": "--show",
      "trayArgs": "",
      "color": "#B26BFF",
      "iconUrl": "https://raw.githubusercontent.com/joshpack/PaxToolkit/main/Assets/icons/PaxMediaManager.png",
      "knownPaths": [ "%LOCALAPPDATA%\\Programs\\PAX Media Manager\\PaxMediaManager.exe" ],
      "uninstall": "uninstall.cmd"
    },
