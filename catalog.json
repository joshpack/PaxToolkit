{
  "schema": 1,
  "apps": [
    {
      "id": "pxdCommander",
      "name": "pxd Commander",
      "tagline": "File manager",
      "description": "Dual-pane file manager with tabs, fast search, previews, FTP/SFTP and a built-in terminal.",
      "repo": "joshpack/pxdCommander",
      "kind": "zip",
      "asset": "^pxdCommander-.*-win-x64-portable\\.zip$",
      "exe": "pxdCommander.exe",
      "selfUpdates": true,
      "folder": "pxdCommander",
      "color": "#89CFF0",
      "iconUrl": "https://raw.githubusercontent.com/joshpack/pxdToolkit/main/Assets/icons/pxdCommander.png",
      "knownPaths": [ "%LOCALAPPDATA%\\Programs\\pxd Commander\\pxdCommander.exe" ],
      "uninstall": "pxdCommander.exe --uninstall --quiet"
    },
    {
      "id": "pxdMediaManager",
      "tray": true,
      "name": "pxd Media Manager",
      "tagline": "Downloads, library and player",
      "description": "Moves finished torrents where they belong, builds a poster library and plays your videos and pictures.",
      "repo": "joshpack/pxdMediaManager",
      "kind": "zip",
      "asset": "^pxdMediaManager-.*-win-x64-portable\\.zip$",
      "exe": "pxdMediaManager.exe",
      "folder": "pxdMediaManager",
      "openArgs": "--show",
      "trayArgs": "",
      "color": "#B26BFF",
      "iconUrl": "https://raw.githubusercontent.com/joshpack/pxdToolkit/main/Assets/icons/pxdMediaManager.png",
      "knownPaths": [ "%LOCALAPPDATA%\\Programs\\pxd Media Manager\\pxdMediaManager.exe" ],
      "uninstall": "uninstall.cmd"
    },
    {
