{
  "schema": 1,
  "apps": [
    {
      "id": "PaxCommander",
      "name": "PAX Commander",
      "tagline": "File manager",
      "description": "Dual-pane file manager with tabs, fast search, previews, FTP/SFTP and a built-in terminal.",
      "repo": "joshpack/PaxCommander",
      "kind": "zip",
      "asset": "^PaxCommander-.*-win-x64-portable\\.zip$",
      "exe": "PaxCommander.exe",
      "selfUpdates": true,
      "folder": "PaxCommander",
      "color": "#89CFF0",
      "iconUrl": "https://raw.githubusercontent.com/joshpack/PaxToolkit/main/Assets/icons/PaxCommander.png",
      "knownPaths": [ "%LOCALAPPDATA%\\Programs\\PAX Commander\\PaxCommander.exe" ],
      "uninstall": "PaxCommander.exe --uninstall --quiet"
    },
    {
      "id": "PaxMediaManager",
      "tray": true,
      "name": "PAX Media Manager",
      "tagline": "Downloads, library and player",
