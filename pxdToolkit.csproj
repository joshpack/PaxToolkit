<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pxdToolkit</RootNamespace>
    <AssemblyName>pxdToolkit</AssemblyName>
    <Version>1.2.0</Version>
    <Product>pxd Toolkit</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\pxdToolkit.ico')">Assets\pxdToolkit.ico</ApplicationIcon>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- Released as one self-contained exe, so it runs on a PC that has no .NET yet. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icons\*.png" />
    <EmbeddedResource Include="catalog.json" LogicalName="catalog.json" />
  </ItemGroup>

  <Target Name="TrimPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PruneFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PruneFiles)" />
  </Target>

</Project>
